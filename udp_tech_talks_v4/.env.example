# Copia este archivo a ".env" (sin ".example") y completa tus claves reales.
# El archivo .env NO se debe compartir ni subir a git (ya está en .gitignore).

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Opcional: activa Jev (Vercel AI Gateway) para elegir charla de forma más robusta
# y moderar las respuestas públicas de la Estación Estudiantes. Si lo dejas vacío,
# la app funciona igual, solo sin esas dos mejoras.
AI_GATEWAY_API_KEY=

# Clave genérica para entrar al panel de administración (src/app.py). Si la dejas
# vacía, el panel queda sin protección (útil solo en desarrollo local).
ADMIN_PASSWORD=

# URL pública donde corre publico/app_publico.py (por ejemplo, la URL de un
# forwarded port de VS Code, o donde despliegues la vista pública). Se usa solo
# para generar el QR de acceso en la pestaña "Cómo funciona" del admin.
PUBLIC_APP_URL=
